{
  "name": "gcse-revision-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Adaptive GCSE revision app: English, Maths, Triple Science, Creative iMedia, Business/Enterprise, History and Statistics for 2027/2028 exams.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
